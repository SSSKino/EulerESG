# Registry order used by scripts/npm-ci-with-registry-fallback.sh:
# 1. https://registry.npmjs.org/ (official, primary)
# 2. https://registry.npmmirror.com/
# 3. https://mirrors.cloud.tencent.com/npm/
# 4. https://repo.huaweicloud.com/repository/npm/
# npm itself supports one active default registry, so only the primary is set
# below; duplicate registry= lines would not form a fallback list.
registry=https://registry.npmjs.org/
fetch-retries=2
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000
prefer-offline=true
fund=false
audit=false
