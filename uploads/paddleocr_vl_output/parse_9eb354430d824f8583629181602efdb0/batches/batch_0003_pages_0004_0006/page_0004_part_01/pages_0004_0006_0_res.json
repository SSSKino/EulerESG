        },
        {
            "block_label": "text",
            "block_content": "From the PC to the internet to the cloud, we've helped customers put their data to work to drive incredible outcomes. Now, with generative AI it feels like the last few decades have just been the pregame show. AI will revolutionize how we live and work, and it will drive unprecedented advances across every domain of human endeavor. From education to healthcare to physics, AI will help deliver radical progress and productivity.",
            "block_bbox": [
                64,
                434,
                578,
                646
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
